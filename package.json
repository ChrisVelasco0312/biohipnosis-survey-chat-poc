{
  "name": "biohipnosis-survey-chat-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof of concept of the Biohipnosis systemic initial-interview WhatsApp chatbot, deployable on Firebase + Cloud Run.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "security": "node --test tests/security/*.test.js",
    "smoke": "node tests/smoke.mjs",
    "allowlist": "node scripts/set-allowlist.mjs"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^8.0.0",
    "@google-cloud/storage": "^9.0.0",
    "firebase-admin": "^14.5.1"
  }
}
